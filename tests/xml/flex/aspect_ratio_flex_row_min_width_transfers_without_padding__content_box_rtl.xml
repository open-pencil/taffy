<test name="aspect_ratio_flex_row_min_width_transfers_without_padding__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" align-items="flex-start" width="500px" height="300px">
      <div box-sizing="content-box" direction="rtl" position="relative" flex-shrink="0" flex-basis="100px" min-width="100px" aspect-ratio="2" padding-top="0px" padding-left="10px" padding-bottom="0px" padding-right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="300">
      <node x="380" y="0" width="120" height="50"/>
    </node>
  </expectations>
</test>
