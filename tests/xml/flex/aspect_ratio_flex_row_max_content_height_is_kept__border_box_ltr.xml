<test name="aspect_ratio_flex_row_max_content_height_is_kept__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" align-items="flex-start" width="500px">
      <div direction="ltr" position="relative" flex-shrink="0" flex-basis="100px" height="max-content" aspect-ratio="1">
        <div direction="ltr" position="relative" width="10px" height="300px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="500" height="300">
      <node x="0" y="0" width="100" height="300">
        <node x="0" y="0" width="10" height="300"/>
      </node>
    </node>
  </expectations>
</test>
