<test name="aspect_ratio_flex_column_grow_transfers_cross_size__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" flex-direction="column" align-items="flex-start" width="100px" height="400px">
      <div direction="ltr" position="relative" flex-grow="1" aspect-ratio="0.5"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="400">
      <node x="0" y="0" width="200" height="400"/>
    </node>
  </expectations>
</test>
